# Postgres
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard
POSTGRES_DB=dashboard

# Backend
NODE_ENV=production
JWT_SECRET=change_me_in_env

# Frontend (build-time, consumed by Vite)
VITE_API_URL=http://localhost:8080

# Set to "development" to build the dev-mode stages (hot reload) instead
BUILD_TARGET=production

# Frontend
FRONTEND_URL=http://localhost:3000

# Public URL of the API (OAuth callbacks are <API_URL>/api/oauth/<provider>/callback)
API_URL=http://localhost:8080

# GitHub / Google sign-in and widgets (leave empty to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the GitHub/Google tokens stored in the database (defaults to JWT_SECRET)
TOKEN_ENCRYPTION_KEY=
